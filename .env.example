# Copy to .env and adjust values:
#   cp .env.example .env

# --- App ---
ENV=dev
SECRET_KEY=change-me-use-a-long-random-string

# --- PostgreSQL (Docker Compose) ---
# Inside containers use POSTGRES_HOST=db and port 5432.
# From the host machine (external tools): localhost + POSTGRES_PUBLISH_PORT (default 5434).
ENGINE=postgresql+psycopg2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=character
POSTGRES_HOST=db
PGTZ=America/Argentina/Buenos_Aires

# Optional host publish ports (docker compose, not read by the Python app)
# API_PUBLISH_PORT=8000
# POSTGRES_PUBLISH_PORT=5434
# NGROK_INSPECT_PORT=4040

# --- ngrok (optional profile: make ngrok) ---
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Reserved URL so the WhatsApp callback does not change on restart.
# Example: https://my-app.ngrok.app
# NGROK_URL=

# --- OAuth: Google (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- OAuth: GitHub (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_INFO_URL=https://api.github.com/user

# --- Frontend (OAuth redirect after login) ---
FRONTEND_URL=http://localhost:5173

# --- MCP (default owner for tool calls; set after first user signup) ---
MCP_DEFAULT_USER_ID=1

# --- Optional runtime tuning ---
# SQLALCHEMY_ECHO=false
# DB_CONNECT_TIMEOUT=10
# WAIT_FOR_DB=true
# RUN_MIGRATIONS=true
# UVICORN_RELOAD=true
# UVICORN_WORKERS=2

# --- CORS (comma-separated origins, or * for dev) ---
BACKEND_CORS_ORIGINS=*

# --- Rate limit (auth endpoints) ---
RATE_LIMIT_SIGNIN=10/minute

# --- WhatsApp Cloud API (optional webhook) ---
# Callback URL: https://<tu-dominio>/api/v1/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN must match the token you set in the Meta app.
# Leave WHATSAPP_APP_SECRET empty only for local dev (signature check is skipped).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# Single-user shortcut: any WhatsApp chat acts as this user until a phone is linked.
# Prefer linking numbers with PUT /api/v1/whatsapp/me.
# WHATSAPP_DEFAULT_USER_ID=1

# --- Natural language on WhatsApp (same tools as MCP) ---
# OpenAI-compatible chat completions. Leave the key empty to keep menu commands only.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
